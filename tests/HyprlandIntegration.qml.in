//@ pragma ShellId omarchy-dock-native-fixture
import QtQuick
import Quickshell
import Quickshell.Hyprland as Hypr

ShellRoot {
    id: root
    property int step: 0
    property int ticks: 0
    property string provider: Quickshell.env("DOCK_QA_PROVIDER")
    Loader { id: platform; source: "backends/" + root.provider + ".qml" }
    Timer {
        interval: 100; running: true; repeat: true
        onTriggered: {
            if (platform.status === Loader.Error) { console.error("DOCK_QA_FAIL backend load"); stop(); return }
            const backend = platform.item
            if (!backend) return
            const fixture = backend.windows.find(window => window.tl.title === __TITLE__ && window.tl.lastIpcObject?.pid === __PID__)
            root.ticks++
            if (root.ticks === 50) {
                const native = Hypr.Hyprland.toplevels.values.find(window => window.title === __TITLE__ || window.lastIpcObject?.title === __TITLE__)
                console.log("DOCK_QA_STATE step=" + root.step + " fixture=" + !!fixture + " native=" + !!native
                    + " title=" + !!(native && native.title === __TITLE__) + " ipc=" + !!native?.lastIpcObject
                    + " address=" + !!native?.address + " class=" + !!native?.lastIpcObject?.class + " lua=" + Hypr.Hyprland.usingLua
                    + " active=" + !!native?.activated + " nativeActive=" + (Hypr.Hyprland.activeToplevel === native)
                    + " waylandActive=" + !!native?.wayland?.activated)
            }
            const reference = backend.windows.find(window => window.tl.title === __REFERENCE__ && window.tl.lastIpcObject?.pid === __PID__)
            if (root.step === 0 && fixture && reference) {
                if (root.provider === "Omarchy" && String(backend.palette.background) !== "#202428") return
                // Tiled fixtures beneath another fullscreen app can have focus redirected.
                for (const window of [fixture, reference]) {
                    const address = backend.address(window.tl)
                    Hypr.Hyprland.dispatch(Hypr.Hyprland.usingLua
                        ? 'hl.dsp.window.float({ window = "address:' + address + '", action = "enable" })'
                        : 'setfloating address:' + address)
                }
                root.step = 1
            } else if (root.step === 1 && fixture && reference) {
                Hypr.Hyprland.refreshToplevels()
                if (!fixture.tl.lastIpcObject.floating || !reference.tl.lastIpcObject.floating) return
                const address = backend.address(reference.tl)
                Hypr.Hyprland.dispatch(Hypr.Hyprland.usingLua
                    ? 'hl.dsp.focus({ window = "address:' + address + '" })'
                    : 'focuswindow address:' + address)
                root.step = 2
            } else if (root.step === 2 && fixture && reference?.tl.activated && !fixture.tl.activated) {
                backend.focusWindow(fixture.tl); root.step = 3
            } else if (root.step === 3 && fixture?.tl.activated) {
                console.log("DOCK_QA_FOCUS")
                backend.minimizeWindow(fixture.tl); root.step = 4
            } else if (root.step === 4 && fixture?.minimized) {
                console.log("DOCK_QA_MINIMIZE")
                backend.restoreWindow(fixture.tl); root.step = 5
            } else if (root.step === 5 && fixture && !fixture.minimized && fixture.tl.activated) {
                console.log("DOCK_QA_RESTORE")
                if (root.provider === "Omarchy") { console.log("DOCK_QA_THEME_READY"); root.step = 6 }
                else { backend.closeWindow(fixture.tl); root.step = 7 }
            } else if (root.step === 6 && fixture && String(backend.palette.background) === "#304858") {
                backend.closeWindow(fixture.tl); root.step = 7
            } else if (root.step === 7 && !fixture && reference) {
                backend.closeWindow(reference.tl); root.step = 8
            } else if (root.step === 8 && !fixture && !reference) {
                console.log("DOCK_QA_PASS usingLua=" + Hypr.Hyprland.usingLua)
                stop()
            }
        }
    }
}
