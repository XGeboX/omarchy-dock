# Maintainer: Anirudh Sharma
pkgname=omarchy-dock
pkgver=0.7.0.dev
_sourcever=0.7.0-dev
pkgrel=1
pkgdesc='Responsive application dock with native Linux desktop integrations'
arch=('any')
url='https://github.com/XGeboX/omarchy-dock'
license=('MIT')
depends=('python')
optdepends=('omarchy>=4.0.4: native Omarchy shell integration'
  'quickshell>=0.3.1: standalone non-GNOME dock'
  'python-gobject: Plasma, Sway and X11 window services'
  'python-dbus: Plasma window service'
  'python-xlib: X11 window service'
  'gnome-shell: native GNOME extension'
  'sway: native Sway IPC window service')
checkdepends=('qt6-declarative' 'qt6-svg' 'python-gobject' 'nodejs')
install=omarchy-dock.install
source=("$pkgname-$_sourcever.tar.gz::$url/releases/download/v$_sourcever/$pkgname-$_sourcever.tar.gz")
sha256sums=('ab75f098da0adf2c4b0a3f9f3c5f7e9e626554a2b5c78315b1fa3fe53f8fc3ad')

check() {
  cd "$srcdir/$pkgname-$_sourcever"
  python3 tools/test.py
}

package() {
  cd "$srcdir/$pkgname-$_sourcever"
  install -d "$pkgdir/usr/share/$pkgname/plugin" "$pkgdir/usr/share/$pkgname/bin"
  cp -a plugin/. "$pkgdir/usr/share/$pkgname/plugin/"
  cp -a integrations "$pkgdir/usr/share/$pkgname/"
  install -Dm644 tools/desktop.py "$pkgdir/usr/share/$pkgname/tools/desktop.py"
  install -m644 shell.qml "$pkgdir/usr/share/$pkgname/"
  install -m644 LICENSE "$pkgdir/usr/share/$pkgname/"
  install -m644 config.example.json "$pkgdir/usr/share/$pkgname/"
  install -m755 bin/omarchy-dock "$pkgdir/usr/share/$pkgname/bin/omarchy-dock"
  install -d "$pkgdir/usr/bin"
  ln -s "../share/$pkgname/bin/omarchy-dock" "$pkgdir/usr/bin/omarchy-dock"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/linux.md "$pkgdir/usr/share/doc/$pkgname/docs/linux.md"
  install -Dm644 docs/hover.png "$pkgdir/usr/share/doc/$pkgname/docs/hover.png"
}
